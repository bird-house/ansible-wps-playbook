{% set nginx_service_name = item.name | regex_replace('[^A-Za-z0-9_]', '_') %}
{% set nginx_cache_zone = 'pywps_' ~ nginx_service_name %}
# pywps web processing service
upstream {{ item.name }} {
    # socket connection
    server unix://{{ wps_run_dir }}/{{ item.name }}.sock fail_timeout=0;
}

proxy_cache_path {{ wps_cache_dir }}/{{ item.name }} levels=1:2
                 keys_zone={{ nginx_cache_zone }}:10m max_size=1g
                 inactive=10m use_temp_path=off;

map $arg_request ${{ nginx_cache_zone }}_nocache {
  default         1;
  GetCapabilities 0;
  DescribeProcess 0;
  Execute         1;
}

{% if wps_enable_acl %}
map $arg_request ${{ nginx_cache_zone }}_deny {
  default         1;
  GetCapabilities 0;
  DescribeProcess 0;
  Execute         1;
}
{% endif %}

server {
    {% if wps_enable_https %}
    listen                 {{ item.port | default('5000') }} ssl http2 default_server;
    listen                 [::]:{{ item.port | default('5000') }} ssl http2 default_server;
    {% else %}
    listen                 {{ item.port | default('5000') }} default_server;
    listen                 [::]:{{ item.port | default('5000') }} default_server;
    {% endif %}
    server_name            {{ item.hostname | default('localhost') }};
    {% if wps_enable_https %}
    ssl_certificate        {{ ssl_certs_cert_path }};
    ssl_certificate_key    {{ ssl_certs_privkey_path }};
    {% endif %}

    # better to redirect / to wps application
    location / {
      return 301 /wps;
    }

    # PyWPS avail at /wps
    location /wps {
        {% if wps_enable_acl %}
        # access control
        limit_except GET {
            {% for ip_range in wps_acl_allow %}
            allow {{ ip_range }};
            {% endfor %}
            deny all;
        }
        if (${{ nginx_cache_zone }}_deny) {
            return 403;
        }
        {% endif %}
        proxy_cache             {{ nginx_cache_zone }};
        proxy_cache_valid       200 10m;
        proxy_cache_bypass      $http_cache_control $arg_nocache;
        proxy_no_cache          $http_pragma ${{ nginx_cache_zone }}_nocache;
        add_header X-Proxy-Cache $upstream_cache_status;
        proxy_set_header        X-Forwarded-Ssl on;
        proxy_set_header        X-Forwarded-Host $host/wps/;
        proxy_set_header        X-Forwarded-Server $host;
        proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
        # proxy_set_header        X-SSL-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header        X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header        X-SSL-Client-S-DN $ssl_client_s_dn;
        proxy_redirect          off;
        proxy_buffering         on;
        client_max_body_size    8m;
        proxy_connect_timeout   {{ nginx_proxy_timeout }};
        proxy_send_timeout      {{ nginx_proxy_timeout }};
        proxy_read_timeout      {{ nginx_proxy_timeout }};
        send_timeout            {{ nginx_proxy_timeout }};
        proxy_pass              http://{{ item.name }};
    }

    {% if not fs_enabled %}
    # PyWPS Outputs
    location /outputs
    {
        alias {{ wps_basedir }}/outputs;
        autoindex off;
    }
    {% endif %}

    # endpoint for load-balancer health checks
    location = /health
    {
        access_log off;
        proxy_connect_timeout {{ nginx_proxy_timeout }};
        proxy_send_timeout    {{ nginx_proxy_timeout }};
        proxy_read_timeout    {{ nginx_proxy_timeout }};
        send_timeout          {{ nginx_proxy_timeout }};
        proxy_pass            http://{{ item.name }}/wps?service=WPS&request=GetCapabilities;
    }

    # endpoint for ROOK process health checks
    location = /health2
    {
        access_log off;
        proxy_connect_timeout {{ nginx_proxy_timeout }};
        proxy_send_timeout    {{ nginx_proxy_timeout }};
        proxy_read_timeout    {{ nginx_proxy_timeout }};
        send_timeout          {{ nginx_proxy_timeout }};
        proxy_pass            http://{{ item.name }}/wps?service=WPS&version=1.0.0&request=Execute&identifier=health&RawDataOutput=status;
    }

}
