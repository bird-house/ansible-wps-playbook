#!/usr/bin/env bash

set -euo pipefail

fail() {
    echo "[ERROR] $*" >&2
    exit 1
}

usage() {
    local exit_code=${1:-2}
    echo "Usage: $command_name SERVICE_NAME [OPTIONS]" >&2
    exit "$exit_code"
}

validate_service_name() {
    if [[ -z ${1:-} || ! $1 =~ ^[A-Za-z0-9_.-]+$ ]]; then
        usage
    fi
}

reject_layer_options() {
    local argument
    for argument in "$@"; do
        case $argument in
            --layer | --layer=*)
                fail "$command_name has a fixed layer scope; --layer is not allowed"
                ;;
        esac
    done
}

main() {
    local command_name=${0##*/}
    local mode
    local -a script_options=()

    case $command_name in
        monitor)
            mode=monitor
            script_options=(
                --layer xml --layer database --layer polling
                --show-summaries
            )
            ;;
        recover-xml)
            mode=recover
            script_options=(--layer xml)
            ;;
        recover-polling)
            mode=recover
            script_options=(--layer polling)
            ;;
        recover-xml-db)
            mode=recover
            script_options=(--layer xml --layer database)
            ;;
        statistics)
            mode=statistics
            script_options=(--layer xml --layer database --show-summaries)
            ;;
        *)
            fail "Unsupported command name: $command_name"
            ;;
    esac

    if [[ ${1:-} == -h || ${1:-} == --help ]]; then
        usage 0
    fi
    [[ $# -ge 1 ]] || usage
    validate_service_name "$1"

    local app=$1
    shift

    reject_layer_options "$@"

    local python="{{ conda_envs_dir }}/$app/bin/python"
    local config_file="/etc/pywps/$app.cfg"
    local job_control_script="{{ cron_script_dir }}/pywps-job-control.py"

    [[ -x $python ]] || fail "Python not found or not executable: $python"
    [[ -f $config_file ]] || fail "PyWPS configuration not found: $config_file"
    [[ -x $job_control_script ]] \
        || fail "PyWPS job-control script not found or not executable: $job_control_script"

    exec "$python" "$job_control_script" \
        --config "$config_file" "$mode" "${script_options[@]}" "$@"
}

main "$@"
