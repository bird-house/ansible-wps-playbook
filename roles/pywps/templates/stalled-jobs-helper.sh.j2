#!/usr/bin/env bash

set -euo pipefail

fail() {
    echo "[ERROR] $*" >&2
    exit 1
}

usage() {
    echo "Usage: $command_name SERVICE_NAME [OPTIONS]" >&2
    exit 2
}

validate_service_name() {
    if [[ -z ${1:-} || ! $1 =~ ^[A-Za-z0-9_.-]+$ ]]; then
        usage
    fi
}

main() {
    local command_name=${0##*/}
    local mode
    local -a layers=()

    case $command_name in
        monitor)
            mode=monitor
            ;;
        recover-xml)
            mode=cleanup
            layers=(--layer xml)
            ;;
        recover-all)
            mode=cleanup
            layers=(--layer xml --layer database)
            ;;
        *)
            fail "Unsupported command name: $command_name"
            ;;
    esac

    [[ $# -ge 1 ]] || usage
    validate_service_name "$1"

    local app=$1
    shift

    local python="{{ conda_envs_dir }}/$app/bin/python"
    local config_file="/etc/pywps/$app.cfg"
    local recovery_script="{{ cron_script_dir }}/recover-stalled-jobs.py"

    [[ -x $python ]] || fail "Python not found or not executable: $python"
    [[ -f $config_file ]] || fail "PyWPS configuration not found: $config_file"
    [[ -x $recovery_script ]] \
        || fail "Recovery script not found or not executable: $recovery_script"

    exec "$python" "$recovery_script" \
        --config "$config_file" "$mode" "${layers[@]}" "$@"
}

main "$@"
