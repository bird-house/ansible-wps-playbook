[metadata:main]
identification_fees = {{ item.identification_fees | default('')}}
identification_accessconstraints = {{ item.identification_accessconstraints | default('')}}
provider_name = {{ item.provider_name | default('')}}
provider_url = {{ item.provider_url | default('')}}
contact_name = {{ item.contact_name | default('')}}
contact_city = {{ item.contact_city | default('')}}
contact_country = {{ item.contact_country | default('')}}
contact_url = {{ item.contact_url | default('')}}

[server]
{% if wps_enable_https %}
{% set _protocol = 'https' %}
{% else %}
{% set _protocol = 'http' %}
{% endif %}
url = {{ _protocol }}://{{ item.hostname | default('localhost') }}:{{ item.port }}/wps
{% if fs_enabled %}
{% set _fs_host = fs_host %}
{% set _fs_port = fs_port %}
{% set _fs_protocol = 'http' %}
{% else %}
{% set _fs_host = item.fs_hostname | default(item.hostname) %}
{% set _fs_port = item.port %}
{% set _fs_protocol = _protocol %}
{% endif %}
{% set _outputurl = '{0}://{1}:{2}/outputs/{3}'.format(_fs_protocol, _fs_host, _fs_port, item.name) %}
outputurl = {{ item.outputurl | default(_outputurl) }}
allowedinputpaths = /
maxsingleinputsize = {{ item.maxsingleinputsize | default('10gb') }}
maxrequestsize = {{ item.maxrequestsize | default('200mb') }}
maxprocesses = {{ item.maxprocesses | default('30') }}
parallelprocesses = {{ item.parallelprocesses | default('4') }}
outputpath= {{ wps_basedir }}/outputs/{{ item.name }}
workdir={{ wps_basedir }}/tmp/{{ item.name }}
sethomedir={{ item.sethomedir | default('false') }}
cleantempdir={{ item.cleantempdir | default('true') }}
storage_copy_function={{ item.storage_copy_function | default('copy') }}

[processing]
mode={{ item.mode | default('default')}}
drmaa_native_specification={{ item.drmaa_native_specification | default('') }}

[logging]
level = {{ item.log_level | default('INFO') }}
file = {{ wps_log_dir }}/{{ item.name }}.log
{% if db_install_sqlite %}
database = sqlite:///{{ wps_basedir }}/db/{{ item.name }}_log.db
{% else %}
database = {{ item.database | default(wps_database) }}
{% endif %}
format = %(asctime)s] [%(levelname)s] %(message)s
http_log_path = {{ wps_http_log_dir | default('/var/log/nginx') }}

[job_control]
# Report stalled requests without changing them.
monitor_enabled = {{ wps_tools_job_control_monitor_enabled | bool | lower }}
# Allow commands that recover stalled requests or status documents.
recovery_enabled = {{ wps_tools_job_control_recovery_enabled | bool | lower }}
# Create failure XML for repeated Nginx 404 status polling.
missing_status_recovery_enabled = {{ wps_tools_missing_status_recovery_enabled | bool | lower }}
long_running_minutes = {{ wps_tools_job_control_long_running_minutes }}
stale_after_minutes = {{ wps_tools_job_control_stale_after_minutes }}
database_stale_after_minutes = {{ wps_tools_job_control_database_stale_after_minutes }}
recovery_max_runtime_minutes = {{ job_timeout_minutes }}
recovery_pending_timeout_minutes = {{ wps_outputs_keep_minutes }}
database_accepted_stale_after_hours = {{ wps_tools_job_control_database_accepted_stale_after_hours }}
database_status_window_hours = {{ wps_tools_job_control_database_status_window_hours }}
recovery_user = {{ wps_user }}
recovery_group = {{ wps_group }}
python_executable = {{ conda_envs_dir }}/{{ item.name }}/bin/python
recovery_working_dir = {{ src_dir }}/{{ item.name }}
recovery_limit = {{ wps_tools_job_control_recovery_limit }}
incident_archive_enabled = {{ wps_tools_incident_archive_enabled | bool | lower }}
incident_archive_dir = {{ wps_tools_incident_archive_dir }}/{{ item.name }}
lock_file = /run/lock/pywps-job-control-{{ item.name }}.lock
access_log = {{ wps_tools_missing_status_access_log }}
poll_window_minutes = {{ wps_tools_missing_status_poll_window_minutes }}
min_poll_count = {{ wps_tools_missing_status_min_poll_count }}
min_poll_duration_minutes = {{ wps_tools_missing_status_min_poll_duration_minutes }}
missing_status_recovery_limit = {{ wps_tools_missing_status_recovery_limit }}
missing_status_database_guard = {{ wps_tools_missing_status_database_guard | bool | lower }}
event_log = {{ wps_log_dir }}/{{ item.name }}-events.jsonl

{% if item.extra_config is defined %}
{{ item.extra_config }}
{% endif %}
