#!/usr/bin/env bash

# Read-only operator wrapper for the PyWPS XML request inspector.

set -euo pipefail

if [[ $# -lt 1 || $1 == -h || $1 == --help ]]; then
    echo "Usage: inspect-jobs SERVICE_NAME [OPTIONS]" >&2
    [[ ${1:-} == -h || ${1:-} == --help ]] && exit 0
    exit 2
fi
if [[ ! $1 =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "Invalid service name: $1" >&2
    exit 2
fi

service=$1
shift
exec /usr/bin/python3 "{{ cron_script_dir }}/pywps-xml-inspect.py" \
    --config "/etc/pywps/$service.cfg" --service "$service" "$@"
