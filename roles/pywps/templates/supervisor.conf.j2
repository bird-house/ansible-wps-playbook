[program:{{ item.name }}]
user={{ wps_user }}
command=bash run.sh
autostart=true
autorestart=unexpected
directory={{ src_dir }}/{{ item.name }}
redirect_stderr=true
stdout_logfile=/var/log/supervisor/{{ item.name }}.log
stopsignal=TERM
stopwaitsecs={{ (gunicorn_graceful_timeout | int) + 10 }}
killasgroup=true
stopasgroup=false
