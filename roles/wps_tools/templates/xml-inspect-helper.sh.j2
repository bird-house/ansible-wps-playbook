#!/usr/bin/env bash

# Read-only operator wrapper for the PyWPS XML request inspector.

set -euo pipefail

if [[ $# -lt 1 || $1 == -h || $1 == --help ]]; then
    echo "Usage: inspect-jobs SERVICE_NAME [OPTIONS]" >&2
    [[ ${1:-} == -h || ${1:-} == --help ]] && exit 0
    exit 2
fi
if [[ ! $1 =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "Invalid service name: $1" >&2
    exit 2
fi

service=$1
shift
config_file="/etc/pywps/$service.cfg"
if [[ ! -f $config_file ]]; then
    echo "PyWPS configuration not found: $config_file" >&2
    exit 1
fi
exec /usr/bin/python3 "{{ wps_tools_script_dir }}/pywps-xml-inspect.py" \
    --config "$config_file" --service "$service" "$@"
