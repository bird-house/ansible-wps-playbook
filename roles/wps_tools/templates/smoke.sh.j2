#!/usr/bin/env bash

set -euo pipefail

fail() {
    echo "[ERROR] $*" >&2
    exit 1
}

validate_service_name() {
    if [[ $# -ne 1 || -z ${1:-} ]]; then
        echo "Usage: smoke SERVICE_NAME" >&2
        exit 2
    fi
    if [[ ! $1 =~ ^[A-Za-z0-9_.-]+$ ]]; then
        echo "Invalid service name: $1" >&2
        exit 2
    fi
}

main() {
    validate_service_name "$@"
    local app=$1
    local app_dir="{{ src_dir }}/$app"
    local config_file="/etc/pywps/$app.cfg"
    local pytest="{{ conda_envs_dir }}/$app/bin/pytest"
    local smoke_tests="$app_dir/tests/smoke"

    [[ -d $app_dir ]] || fail "Application directory not found: $app_dir"
    [[ -f $config_file ]] || fail "PyWPS configuration not found: $config_file"
    [[ -x $pytest ]] || fail "pytest not found or not executable: $pytest"
    [[ -d $smoke_tests ]] || fail "Smoke-test directory not found: $smoke_tests"

    export PYWPS_CFG="$config_file"
    cd "$app_dir"
    exec "$pytest" -v -k smoke "$smoke_tests"
}

main "$@"
