#!/usr/bin/env python3
"""Write a readable daily or hourly summary from collectd CSV files."""

import argparse
import csv
from collections import namedtuple
from datetime import date, datetime, timedelta
import fcntl
import gzip
import os
from pathlib import Path
import sys
import tempfile


GIB = 1024**3
SummaryWindow = namedtuple(
    "SummaryWindow", ("label", "file_date", "start_epoch", "end_epoch")
)


def iso_date(value):
    try:
        return date.fromisoformat(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must use YYYY-MM-DD") from error


def iso_hour(value):
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H")
    except ValueError as error:
        raise argparse.ArgumentTypeError("must use YYYY-MM-DDTHH") from error


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--csv-dir", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--period", choices=("daily", "hourly"), default="daily")
    parser.add_argument("--date", type=iso_date)
    parser.add_argument("--hour", type=iso_hour)
    parser.add_argument("--load", action="store_true")
    parser.add_argument("--disk-mount")
    parser.add_argument("--memory", action="store_true")
    parser.add_argument("--interface")
    parser.add_argument(
        "--lock-file",
        type=Path,
        default=Path("/run/collectd-summary/lock"),
    )
    return parser.parse_args(argv)


def validate_args(args):
    if not args.csv_dir.is_absolute() or args.csv_dir == Path("/"):
        raise ValueError("--csv-dir must be an absolute path other than /")
    if not args.csv_dir.is_dir():
        raise ValueError(f"collectd CSV directory does not exist: {args.csv_dir}")
    if not args.output.is_absolute():
        raise ValueError("--output must be an absolute path")
    if not args.lock_file.is_absolute():
        raise ValueError("--lock-file must be an absolute path")
    if not any((args.load, args.disk_mount, args.memory, args.interface)):
        raise ValueError("at least one metric must be enabled")
    if args.disk_mount and not args.disk_mount.startswith("/"):
        raise ValueError("--disk-mount must be an absolute path")
    if args.period == "daily" and args.hour is not None:
        raise ValueError("--hour can only be used with --period hourly")
    if args.period == "hourly" and args.date is not None:
        raise ValueError("--date can only be used with --period daily")


def summary_window(args):
    if args.period == "daily":
        summary_date = args.date or date.today() - timedelta(days=1)
        return SummaryWindow(summary_date.isoformat(), summary_date, None, None)

    start = args.hour
    if start is None:
        start = datetime.now().replace(minute=0, second=0, microsecond=0)
        start -= timedelta(hours=1)
    end = start + timedelta(hours=1)
    return SummaryWindow(
        start.strftime("%Y-%m-%dT%H:00"),
        start.date(),
        start.timestamp(),
        end.timestamp(),
    )


def open_csv(path):
    if path.is_file():
        return path.open(encoding="utf-8", newline="")
    compressed = Path(f"{path}.gz")
    if compressed.is_file():
        return gzip.open(compressed, mode="rt", encoding="utf-8", newline="")
    raise FileNotFoundError(path)


def values_from_column(path, column, start_epoch=None, end_epoch=None):
    with open_csv(path) as source:
        reader = csv.DictReader(source)
        if not reader.fieldnames or column not in reader.fieldnames:
            raise ValueError(f"missing column {column!r} in {path}")
        if start_epoch is not None and "epoch" not in reader.fieldnames:
            raise ValueError(f"missing column 'epoch' in {path}")
        values = []
        for row in reader:
            if start_epoch is not None:
                timestamp = float(row["epoch"])
                if timestamp < start_epoch or timestamp >= end_epoch:
                    continue
            value = row[column].strip()
            if value:
                values.append(float(value))
    if not values:
        raise ValueError(f"no values in column {column!r} in {path}")
    return values


def min_max(path, column, scale=1.0, start_epoch=None, end_epoch=None):
    values = values_from_column(path, column, start_epoch, end_epoch)
    return round(min(values) * scale, 2), round(max(values) * scale, 2)


def received_gib(path, start_epoch=None, end_epoch=None):
    values = values_from_column(path, "rx", start_epoch, end_epoch)
    total = 0
    previous = None
    for value in values:
        current = int(value)
        if previous is not None:
            delta = current - previous
            total += current if delta < 0 else delta
        previous = current
    return round(total / GIB, 2)


def disk_plugin_instance(mount_point):
    if mount_point == "/":
        return "root"
    return mount_point.strip("/").replace("/", "-")


def metric_path(csv_dir, plugin, metric, summary_date):
    return csv_dir / plugin / f"{metric}-{summary_date.isoformat()}"


def format_value(value):
    return "NA" if value is None else str(value)


def summarize(args, window):
    fields = []
    warnings = []

    def capture(label, callback):
        try:
            return callback()
        except (OSError, ValueError) as error:
            warnings.append(f"{label}: {error}")
            return None

    if args.load:
        result = capture(
            "load",
            lambda: min_max(
                metric_path(args.csv_dir, "load", "load", window.file_date),
                "shortterm",
                start_epoch=window.start_epoch,
                end_epoch=window.end_epoch,
            ),
        )
        minimum, maximum = result if result is not None else (None, None)
        fields.extend(
            (f"load_min={format_value(minimum)}", f"load_max={format_value(maximum)}")
        )

    if args.disk_mount:
        plugin = f"df-{disk_plugin_instance(args.disk_mount)}"
        result = capture(
            "disk",
            lambda: min_max(
                metric_path(
                    args.csv_dir, plugin, "percent_bytes-used", window.file_date
                ),
                "value",
                start_epoch=window.start_epoch,
                end_epoch=window.end_epoch,
            ),
        )
        minimum, maximum = result if result is not None else (None, None)
        fields.extend(
            (f"disk_min={format_value(minimum)}", f"disk_max={format_value(maximum)}")
        )

    if args.memory:
        result = capture(
            "memory",
            lambda: min_max(
                metric_path(
                    args.csv_dir, "memory", "memory-used", window.file_date
                ),
                "value",
                scale=1 / GIB,
                start_epoch=window.start_epoch,
                end_epoch=window.end_epoch,
            ),
        )
        minimum, maximum = result if result is not None else (None, None)
        fields.extend(
            (
                f"mem_min={format_value(minimum)} GiB" if minimum is not None else "mem_min=NA",
                f"mem_max={format_value(maximum)} GiB" if maximum is not None else "mem_max=NA",
            )
        )

    if args.interface:
        received = capture(
            "interface",
            lambda: received_gib(
                metric_path(
                    args.csv_dir,
                    f"interface-{args.interface}",
                    "if_octets",
                    window.file_date,
                ),
                start_epoch=window.start_epoch,
                end_epoch=window.end_epoch,
            ),
        )
        fields.append(
            f"{args.interface}_rx={format_value(received)} GiB"
            if received is not None
            else f"{args.interface}_rx=NA"
        )

    return f"{window.label}  {'  '.join(fields)}", warnings


def write_summary(output, summary_key, line):
    output.parent.mkdir(parents=True, exist_ok=True)
    existing = output.read_text(encoding="utf-8").splitlines() if output.exists() else []
    updated = [entry for entry in existing if not entry.startswith(f"{summary_key}  ")]
    updated.append(line)
    updated.sort(key=lambda entry: entry.split(maxsplit=1)[0])

    descriptor, temporary_name = tempfile.mkstemp(
        dir=output.parent,
        prefix=f".{output.name}.",
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as target:
            target.write("\n".join(updated))
            target.write("\n")
        os.chmod(temporary, 0o644)
        temporary.replace(output)
    finally:
        temporary.unlink(missing_ok=True)


def main(argv=None):
    args = parse_args(argv)
    try:
        validate_args(args)
        window = summary_window(args)
        args.lock_file.parent.mkdir(parents=True, exist_ok=True)
        with args.lock_file.open("a+") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print("collectd summary is already running; skipping")
                return 0

            line, warnings = summarize(args, window)
            write_summary(args.output, window.label, line)
    except (OSError, ValueError) as error:
        print(f"collectd summary failed: {error}", file=sys.stderr)
        return 1

    print(line)
    for warning in warnings:
        print(f"collectd summary warning: {warning}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
